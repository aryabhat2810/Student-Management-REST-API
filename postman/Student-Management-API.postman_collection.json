    },
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"rollNo\": \"CS101\",\n  \"course\": \"Computer Engineering\",\n  \"semester\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Student created with 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Response contains student ID', () => pm.expect(json.data._id).to.exist);",
              "if (json.data && json.data._id) pm.collectionVariables.set('studentId', json.data._id);"
            ]
          }
        }
      ]
    },
